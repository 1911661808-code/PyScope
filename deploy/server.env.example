# Optional host process environment; no credentials belong in this file.
# The unit sets DOCKER_HOST=unix://%t/docker.sock for the dedicated user.
# Change PATH only when Docker CLI is installed outside /usr/bin.
PATH=/usr/local/bin:/usr/bin:/bin

# Never point the application at a root-owned Docker socket or public TCP API.
# Never pass this host environment or any Docker socket to task containers.
